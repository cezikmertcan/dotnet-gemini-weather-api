# Copy this file to .env and replace GEMINI_API_KEY before starting the API.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash

JWT_SIGNING_KEY=replace-with-a-long-local-development-signing-key
JWT_ISSUER=GeminiWeatherApi
JWT_AUDIENCE=GeminiWeatherApi.Client
JWT_ACCESS_TOKEN_MINUTES=60

DATABASE_CONNECTION=Host=localhost;Port=5432;Database=gemini_weather;Username=gemini_weather;Password=local-dev-only
REDIS_CONNECTION=localhost:6379

POSTGRES_DB=gemini_weather
POSTGRES_USER=gemini_weather
POSTGRES_PASSWORD=local-dev-only
